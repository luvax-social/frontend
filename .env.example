# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
# Backend URL that starts the Google OAuth flow.
# Do not use /api/v1/auth/oauth2/callback/google here because that is the callback endpoint.
# This contract follows the backend OAuth2 module under /api/v1/auth/oauth2.
VITE_GOOGLE_AUTH_URL=http://localhost:8080/api/v1/auth/oauth2/authorize/google
# Backend success handler redirects the browser back to this frontend route with ?code=...
VITE_GOOGLE_REDIRECT_PATH=/oauth2/callback

# Application
VITE_APP_NAME=MyApp
VITE_APP_ENV=development

# Cloudflare Turnstile site key. It now governs the authentication forms too - login,
# register, forgot password, reset password and resend verification - as well as the
# report dialog and the public support form. The Google sign-in callback is deliberately
# not challenged.
# This is Cloudflare's documented always-pass test key, which is what local work
# and the test suite use; the challenge renders and solves itself without
# contacting a real site configuration. Production keys are configured per
# deployment and are not held here.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
